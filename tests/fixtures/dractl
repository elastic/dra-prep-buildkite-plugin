#!/usr/bin/env bash
# Fake dractl binary used by bats tests — mimics `dractl prep` output
set -euo pipefail

output_dir="./dra"
stack_version="9.5.0-SNAPSHOT"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output-dir)    output_dir="$2";    shift 2 ;;
    --stack-version) stack_version="$2"; shift 2 ;;
    *)               shift ;;
  esac
done

mkdir -p "${output_dir}"
echo "9.5.0-ab12cd34" > "${output_dir}/build_id"
echo '{"manifest_version":"2.1.0","build_id":"9.5.0-ab12cd34"}' \
  > "${output_dir}/manifest-${stack_version}.json"
echo "<html><body>DRA Summary for ${stack_version}</body></html>" \
  > "${output_dir}/summary-${stack_version}.html"
