#!/usr/bin/env bash
set -euo pipefail

DRACTL_VERSION="v0.1.2"

if [[ "${BUILDKITE_COMMAND_EXIT_STATUS:-0}" != "0" ]]; then
  echo "--- :skip: Producer step failed (exit ${BUILDKITE_COMMAND_EXIT_STATUS}), skipping DRA prep"
  exit 0
fi

echo "--- :package: DRA Prep (dractl ${DRACTL_VERSION})"

product_id="${BUILDKITE_PLUGIN_DRA_PREP_PRODUCT_ID:-}"
stack_version="${BUILDKITE_PLUGIN_DRA_PREP_STACK_VERSION:-}"
workflow="${BUILDKITE_PLUGIN_DRA_PREP_WORKFLOW:-}"
fail_on_diff="${BUILDKITE_PLUGIN_DRA_PREP_FAIL_ON_DIFF:-false}"

[[ -n "${product_id}" ]] || {
  echo "ERROR: plugin config 'product_id' is required" >&2
  exit 1
}
[[ -n "${stack_version}" ]] || {
  echo "ERROR: plugin config 'stack_version' is required" >&2
  exit 1
}
[[ -n "${workflow}" ]] || {
  echo "ERROR: plugin config 'workflow' is required" >&2
  exit 1
}

if [[ -z "${VAULT_GITHUB_TOKEN:-}" ]]; then
  echo "ERROR: VAULT_GITHUB_TOKEN is not set." >&2
  echo "       Add elastic/dractl to your pipeline's GithubPermissionSet." >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "ERROR: jq is required but was not found in PATH." >&2
  exit 1
fi

artifacts_dir="artifacts"
if [[ ! -d "${artifacts_dir}" ]] || [[ -z "$(find "${artifacts_dir}" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
  echo "ERROR: expected artifacts directory '${artifacts_dir}/' is absent or empty." >&2
  echo "       Stage your build output under ${artifacts_dir}/ before the plugin runs." >&2
  exit 1
fi

case "$(uname -m)" in
  x86_64) arch="amd64" ;;
  aarch64 | arm64) arch="arm64" ;;
  *)
    echo "ERROR: unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

archive="dractl_${DRACTL_VERSION#v}_linux_${arch}.tar.gz"

# elastic/dractl is a private repo, so release assets must be fetched via the
# API's asset endpoint (which returns a signed redirect) rather than the
# github.com/.../releases/download/... URL, which only works for public repos.
echo "Resolving release assets for ${DRACTL_VERSION}..."
release_json="$(curl -fsSL \
  -H "Authorization: Bearer ${VAULT_GITHUB_TOKEN}" \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/elastic/dractl/releases/tags/${DRACTL_VERSION}")" || {
  echo "ERROR: could not fetch dractl ${DRACTL_VERSION} release metadata from GitHub." >&2
  echo "       Verify the release exists and elastic/dractl is in the pipeline's GithubPermissionSet." >&2
  exit 1
}

download_asset() {
  local name="$1" dest="$2" asset_url
  asset_url="$(jq -r --arg name "${name}" '.assets[] | select(.name == $name) | .url' <<<"${release_json}")"
  [[ -n "${asset_url}" ]] || {
    echo "ERROR: release asset '${name}' not found in dractl ${DRACTL_VERSION}" >&2
    exit 1
  }
  curl -fsSL \
    -H "Authorization: Bearer ${VAULT_GITHUB_TOKEN}" \
    -H "Accept: application/octet-stream" \
    -o "${dest}" \
    "${asset_url}"
}

echo "Downloading ${archive}..."
download_asset "${archive}" "${tmp}/${archive}"
download_asset "checksums.txt" "${tmp}/checksums.txt"

echo "Verifying checksum..."
expected="$(awk -v f="${archive}" '$2 == f {print $1}' "${tmp}/checksums.txt")"
actual="$(sha256sum "${tmp}/${archive}" | awk '{print $1}')"
if [[ "${expected}" != "${actual}" ]]; then
  echo "ERROR: checksum mismatch for ${archive}" >&2
  echo "  expected: ${expected}" >&2
  echo "  actual:   ${actual}" >&2
  exit 1
fi

tar -xzf "${tmp}/${archive}" -C "${tmp}"
chmod +x "${tmp}/dractl"

echo "Running dractl prep..."
dractl_args=(
  --product-id "${product_id}"
  --stack-version "${stack_version}"
  --workflow "${workflow}"
  --artifacts-dir "${artifacts_dir}"
  --branch "${BUILDKITE_BRANCH}"
  --commit "${BUILDKITE_COMMIT}"
)
if [[ "${fail_on_diff}" == "true" ]]; then
  dractl_args+=(--fail-on-diff)
fi
"${tmp}/dractl" prep "${dractl_args[@]}"

# dractl generates the build id internally, so the manifest path isn't known
# ahead of time. The artifacts dir is freshly staged per build, so exactly one
# manifest is expected.
manifest="$(find "${artifacts_dir}/dra/${product_id}" -name "manifest-${stack_version}.json" 2>/dev/null | sort | head -1)"
[[ -n "${manifest}" ]] || {
  echo "ERROR: no manifest-${stack_version}.json found under ${artifacts_dir}/dra/${product_id}" >&2
  exit 1
}
build_id="$(jq -r '.build_id' "${manifest}")"
echo "Setting DRA_VERSION_BUILD_ID=${build_id}"
buildkite-agent meta-data set DRA_VERSION_BUILD_ID "${build_id}"

echo "--- :gcp: Uploading DRA artifacts to GCS..."
"${tmp}/dractl" upload \
  --artifacts-dir "${artifacts_dir}" \
  --product-id "${product_id}" \
  --build-id "${build_id}" \
  --workflow "${workflow}" \
  --pipeline-slug "${BUILDKITE_PIPELINE_SLUG}" \
  --build-number "${BUILDKITE_BUILD_NUMBER}"

echo "Upload complete."
